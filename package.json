{
  "name": "new-vision",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "@tiptap/extension-find-and-replace": "3.33.0",
    "@tiptap/extension-highlight": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-link": "3.33.0",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/extension-subscript": "3.33.0",
    "@tiptap/extension-superscript": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-task-item": "3.33.0",
    "@tiptap/extension-task-list": "3.33.0",
    "@tiptap/extension-text-align": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0"
  },
  "build": {
    "appId": "local.new-vision",
    "productName": "New Vision",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
